#!/usr/bin/env python3
"""Flag clear-voice rule breaks that a script can see.

Reads FILE arguments, or stdin when there are none. Prints one line per hit
as `file:line: rule N: message` and exits 1 if anything was flagged. Text
inside fenced code blocks and inline backticks is skipped, since code and
quoted output are not prose.
"""

import re
import sys

# (rule id, pattern, message). Patterns match whole words, case-insensitive.
CHECKS = [
    (5, r"\b(leverag\w*|utiliz\w*|facilitat\w*)\b", "use a plain word: use, help"),
    (5, r"\b(serves as|stands as|boasts)\b", "say 'is' or 'has'"),
    (5, r"\b(in order to|due to the fact that|it is important to note that)\b", "filler: cut or shorten"),
    (6, r"\b(delve\w*|crucial|pivotal|robust|seamless\w*|comprehensive|landscape|tapestry|testament|underscor\w*|showcas\w*|foster\w*|enhanc\w*|intricate|vibrant|additionally)\b", "stock AI vocabulary"),
    (8, r"\b(substrate|north star|flywheel|endgame|paradigm)\b", "metaphor noun: use the concrete word"),
    (13, r"\b(could potentially|might possibly|may potentially)\b", "stacked hedge: hedge once"),
    (14, r"\bnot (just|only|merely) [^.]{1,60}?,? but\b", "'not just X, but Y': state the point"),
    (15, r"\u2014", "em dash: use a period or comma"),
    (18, r"[\u201c\u201d\u2018\u2019]", "curly quote: use straight quotes"),
    (30, r"\[(here|click here|this link|link)\]", "link text: name the target"),
    (31, r"\b\d{1,2}/\d{1,2}/\d{2,4}\b", "ambiguous date: use YYYY-MM-DD"),
    (32, r"(\be\.g\.|\bi\.e\.|\betc\.)", "Latin abbreviation: for example, that is, and so on"),
    (32, r"\b(simply|please)\b", "drop the softener"),
    (20, r"\b(great question|certainly!|i hope this helps|let me know if|happy to help|absolutely right)\b", "chatbot phrase"),
]
COMPILED = [(rule, re.compile(p, re.IGNORECASE), msg) for rule, p, msg in CHECKS]
INLINE_CODE = re.compile(r"`[^`]*`")

# Rule 33: a paragraph or list item holds at most this many sentences. A list
# item is one idea too, so it gets the same limit as a paragraph.
MAX_SENTENCES = 3
MAX_ITEM_WORDS = 60  # rule 11: one idea per bullet
MAX_LEAD_WORDS = 45  # rule 1: the first block states the answer, briefly
MAX_LEAD_SENTENCES = 2
MAX_PROSE_WORDS = 350  # rule 2: proof goes in <details>, not the lead text
MAX_LINE_CHARS = 400  # rule 11: a longer line is several ideas
# rule 1: a lead that opens with context, not the answer
LEAD_CONTEXT = re.compile(r"^\s*(why|context|background|motivation|the problem|problem)\b[^:\n]{0,40}:", re.IGNORECASE)
DETAILS_OPEN = re.compile(r"<details\b", re.IGNORECASE)
DETAILS_CLOSE = re.compile(r"</details>", re.IGNORECASE)
BLOCK_START = re.compile(r"\s*([-*+]|\d+[.)])\s")  # a list item starts its own block
NOT_PROSE = re.compile(r"\s*(#|\||<!--)")  # headings, table rows, HTML comments
LEAD_LABEL = re.compile(r"^\s*\*\*[^*]+\*\*")  # "**Changes.** ..." opens with a label, not a sentence
LINK_TARGET = re.compile(r"\]\([^)]*\)")
SENTENCE_END = re.compile(r"[.!?][\"')*_]*(?=\s|$)")


def sentence_count(block):
    prose = LINK_TARGET.sub("]", LEAD_LABEL.sub("", INLINE_CODE.sub("", block)))
    return len(SENTENCE_END.findall(prose))


def long_paragraphs(name, prose_lines):
    """prose_lines: (line number, text) pairs, with None marking a block break."""
    hits = []
    block, start = [], None
    lead_done = False

    def flush():
        nonlocal lead_done
        if block:
            text = " ".join(block)
            count = sentence_count(text)
            words = len(text.split())
            if BLOCK_START.match(block[0]):
                if count > MAX_SENTENCES:
                    hits.append(f"{name}:{start}: rule 33: list item has {count} sentences: one idea per bullet")
                if words > MAX_ITEM_WORDS:
                    hits.append(f"{name}:{start}: rule 11: list item has {words} words: split it into bullets")
            else:
                if count > MAX_SENTENCES:
                    hits.append(f"{name}:{start}: rule 33: paragraph has {count} sentences: split it or make a list")
                # A label such as "Summary" is not the lead; the block after it is.
                if not lead_done and (count or words > 4):
                    lead_done = True
                    if LEAD_CONTEXT.match(text):
                        hits.append(f"{name}:{start}: rule 1: context before the answer: state the result first")
                    elif count > MAX_LEAD_SENTENCES or words > MAX_LEAD_WORDS:
                        hits.append(f"{name}:{start}: rule 1: the lead is {count} sentences and {words} words: state the answer in one or two")
        block.clear()

    for entry in prose_lines:
        if entry is None:
            flush()
            continue
        number, line = entry
        if BLOCK_START.match(line):
            flush()
        if not block:
            start = number
        block.append(line)
    flush()
    return hits


def check(name, text):
    hits = []
    prose_lines = []
    in_fence = in_details = False
    outside_details_words = 0
    for number, line in enumerate(text.splitlines(), 1):
        if line.lstrip().startswith("```"):
            in_fence = not in_fence
            prose_lines.append(None)
            continue
        if in_fence:
            continue
        if len(line) > MAX_LINE_CHARS:
            hits.append(f"{name}:{number}: rule 11: line is {len(line)} chars: split it into sentences or bullets")
        if DETAILS_OPEN.search(line):
            in_details = True
        if not in_details:
            outside_details_words += len(line.split())
        if DETAILS_CLOSE.search(line):
            in_details = False
        if not line.strip() or NOT_PROSE.match(line):
            prose_lines.append(None)
        else:
            prose_lines.append((number, line))
        prose = INLINE_CODE.sub("", line)
        for rule, pattern, msg in COMPILED:
            for match in pattern.finditer(prose):
                hits.append(f"{name}:{number}: rule {rule}: {msg} ({match.group(0)!r})")
    if outside_details_words > MAX_PROSE_WORDS:
        hits.append(f"{name}: rule 2: {outside_details_words} words outside <details>: cut, or move proof into a <details> block")
    return hits + long_paragraphs(name, prose_lines)


def main(paths):
    sources = [(p, open(p, encoding="utf-8").read()) for p in paths] or [("<stdin>", sys.stdin.read())]
    hits = [hit for name, text in sources for hit in check(name, text)]
    for hit in hits:
        print(hit)
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
