#!/usr/bin/env python3
"""Ship helper: PR brief, readiness check, and milestone formatting.

Used by the ship playbook to verify a PR is open before watching CI and to
format structured milestones for the run record.
"""

import argparse
import json
import subprocess
import sys


def run_gh_json(args):
    """Run a gh command and parse its stdout as JSON. None on any failure."""
    try:
        out = subprocess.run(["gh", *args], capture_output=True, text=True, check=True)
    except (OSError, subprocess.CalledProcessError):
        return None
    try:
        return json.loads(out.stdout)
    except ValueError:
        return None


def pr_brief(repo, pr):
    """Return a dict with pr_url, head_sha, branch, state, title, changed_files.

    Returns None when gh cannot read the PR.
    """
    data = run_gh_json(["pr", "view", str(pr), "--repo", repo,
                        "--json", "url,headRefOid,headRefName,state,title"])
    if data is None:
        return None
    text = run_gh_json(["pr", "diff", str(pr), "--repo", repo, "--name-only"])
    files = []
    if isinstance(text, str):
        files = [line for line in text.splitlines() if line.strip()]
    elif isinstance(text, list):
        files = text
    return {
        "pr_url": data.get("url"),
        "head_sha": data.get("headRefOid"),
        "branch": data.get("headRefName"),
        "state": data.get("state"),
        "title": data.get("title"),
        "changed_files": files,
    }


def check(repo, pr):
    """Check whether the PR is ready to ship.

    Returns a dict with ``ready`` (bool) and the brief fields when readable.
    """
    brief = pr_brief(repo, pr)
    if brief is None:
        return {"ready": False, "reason": "could not read PR"}
    if brief["state"] != "OPEN":
        return {"ready": False, "reason": f"PR is {brief['state']}"}
    return {"ready": True, **brief}


def milestone(tag, data):
    """Return a ship milestone record dict."""
    return {"milestone": tag, "data": data}


def main():
    parser = argparse.ArgumentParser(prog="ship", description="Ship helper for PR shipping")
    sub = parser.add_subparsers(required=True)

    p = sub.add_parser("brief", help="print PR brief as JSON")
    p.add_argument("--repo", required=True)
    p.add_argument("--pr", required=True, type=int)

    def do_brief(args):
        brief = pr_brief(args.repo, args.pr)
        if brief is None:
            sys.exit(1)
        print(json.dumps(brief))

    p.set_defaults(func=do_brief)

    p = sub.add_parser("check", help="check if the PR is ready to ship")
    p.add_argument("--repo", required=True)
    p.add_argument("--pr", required=True, type=int)

    def do_check(args):
        print(json.dumps(check(args.repo, args.pr)))

    p.set_defaults(func=do_check)

    p = sub.add_parser("milestone", help="print a ship milestone record as JSON")
    p.add_argument("--tag", required=True,
                   choices=["started", "watching", "failure", "repair-dispatched",
                            "operator-decision", "green", "merged", "stopped"])
    p.add_argument("--data", type=json.loads, default={})

    def do_milestone(args):
        print(json.dumps(milestone(args.tag, args.data)))

    p.set_defaults(func=do_milestone)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
