#!/usr/bin/env python3
"""Print only the Context churn section of the miner's summary."""

import argparse
import subprocess
import sys
from pathlib import Path


def main():
    argparse.ArgumentParser(
        prog="churn-report",
        description=__doc__,
        epilog="Uses mine's existing source selection, including profile state databases.",
    ).parse_args()
    result = subprocess.run(
        [sys.executable, str(Path(__file__).resolve().with_name("mine")),
         "--format", "summary"],
        stdout=subprocess.PIPE,
    )
    # Stderr is inherited, including diagnostics on successful mining passes.
    if result.returncode != 0:
        return result.returncode

    section = []
    for line in result.stdout.splitlines(keepends=True):
        if not section:
            if line.startswith(b"Context churn:"):
                section.append(line)
        elif line.strip() and not line[:1].isspace():
            break
        else:
            section.append(line)
    if not section:
        print("churn-report: mine summary has no Context churn section", file=sys.stderr)
        return 1
    sys.stdout.buffer.write(b"".join(section))
    return 0


if __name__ == "__main__":
    sys.exit(main())
