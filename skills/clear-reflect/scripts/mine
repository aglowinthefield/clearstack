#!/usr/bin/env python3
"""Mine agent history for repeated waste and propose guards.

Reads ~/.hermes/state.db and ~/.local/state/clearstack/runs.jsonl.
Proposes, never applies. Emit a machine-readable report and a short human summary.
"""

import argparse
import json
import os
import re
import sqlite3
import sys
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import lane_ideation

try:
    import yaml
except ImportError:  # the repo is standard-library only; fall back to the subset parser
    yaml = None


def _parse_scalar(s):
    s = s.strip()
    if not s:
        return None
    if s.startswith("[") and s.endswith("]"):
        inner = s[1:-1].strip()
        return [_parse_scalar(x) for x in inner.split(",")] if inner else []
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "'\"":
        return s[1:-1]
    try:
        return int(s)
    except ValueError:
        return s


def _yaml_subset_load(text):
    """Parse the domain-map YAML subset with stdlib only: nested key maps by
    indentation, 'key: value' scalars, inline [a, b] lists, and '- item' block
    lists. Full-line comments and blanks are skipped. Used when PyYAML is not
    installed, which is every environment this repo guarantees (stdlib only)."""
    lines = []
    for raw in text.splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        lines.append((len(raw) - len(raw.lstrip()), raw.strip()))
    pos = 0

    def parse_block(indent):
        nonlocal pos
        is_list = lines[pos][1].startswith("- ")
        container = [] if is_list else {}
        while pos < len(lines):
            ind, content = lines[pos]
            if ind < indent:
                break
            if ind > indent:
                raise ValueError(f"unexpected indent before {content!r}")
            pos += 1
            if is_list:
                if not content.startswith("- "):
                    raise ValueError(f"expected list item, got {content!r}")
                item = content[2:].strip()
                container.append(_parse_scalar(item) if item else parse_block(lines[pos][0]))
                continue
            key, _, value = content.partition(":")
            key, value = key.strip(), value.strip()
            if value:
                container[key] = _parse_scalar(value)
            elif pos < len(lines) and lines[pos][0] > indent:
                container[key] = parse_block(lines[pos][0])
            else:
                container[key] = None
        return container

    return parse_block(0) if lines else {}


def _yaml_safe_load(text):
    stripped = text.lstrip()
    if stripped.startswith("{") or stripped.startswith("["):
        return json.loads(text)  # JSON is valid YAML; fixtures use it
    if yaml is not None:
        return yaml.safe_load(text)
    return _yaml_subset_load(text)


DEFAULT_STATE_DB = Path.home() / ".hermes" / "state.db"
DEFAULT_RUNS_LOG = Path.home() / ".local" / "state" / "clearstack" / "runs.jsonl"
DEFAULT_SKILLS_DIR = Path.home() / ".hermes" / "skills"
DEFAULT_AGENT_HOOKS_DIR = Path.home() / ".hermes" / "agent-hooks"
DEFAULT_SCRIPTS_DIR = Path.home() / ".hermes" / "scripts"
DEFAULT_KANBAN_BOARDS_DIR = Path.home() / ".hermes" / "kanban" / "boards"
SIZE_THRESHOLD = 20000
REPEAT_MIN_COUNT = 3
DISCORD_MESSAGE_LIMIT = 1900
DISCORD_ITEMS_PER_SECTION = 5
DISCORD_LABEL_LIMIT = 80
# Context-churn detector thresholds.
CHURN_MIN_RUNS = 3  # card is churned at this many worker runs
AMPLIFY_MIN_RATIO = 200  # input-side tokens per output token
AMPLIFY_MIN_INPUT_SIDE = 1_000_000  # ... and at least this much absolute volume
KANBAN_TASK_RE = re.compile(r"kanban task (t_[0-9a-f]+)")

# Seasonal or project-bound skills the detector reports but marks keep.
# Edit this list in place; the detector proposes, never uninstalls.
KEEP_LIST = {
    "weekly-review-planning",
    "retro",
    "workday-activity-review",
}


def connect_db(path):
    """Open the state database read-only. Return (connection, note)."""
    if not path.exists():
        return None, f"state db not found at {path}"
    try:
        uri = f"file:{path}?mode=ro"
        conn = sqlite3.connect(uri, uri=True)
        conn.row_factory = sqlite3.Row
        return conn, None
    except sqlite3.Error as e:
        return None, f"could not open state db: {e}"


def parse_tool_calls(tool_calls_json):
    """Parse assistant tool_calls JSON into a list of (call_id, tool_name, arguments)."""
    if not tool_calls_json:
        return []
    try:
        calls = json.loads(tool_calls_json)
    except (ValueError, TypeError):
        return []
    parsed = []
    for call in calls:
        if not isinstance(call, dict):
            continue
        call_id = call.get("id") or call.get("call_id") or ""
        func = call.get("function", {})
        if isinstance(func, dict):
            name = func.get("name", "")
            args = func.get("arguments", "{}")
            try:
                args = json.loads(args) if isinstance(args, str) else args
            except (ValueError, TypeError):
                args = {}
        else:
            name = call.get("name", "")
            args = call.get("arguments", {})
        parsed.append((call_id, name, args))
    return parsed


def normalize_call(tool_name, arguments):
    """Return a normalized command string for deduplication."""
    if not isinstance(arguments, dict):
        return f"{tool_name} ?"

    if tool_name == "terminal":
        cmd = arguments.get("command", "")
        workdir = arguments.get("workdir", "")
        if workdir and cmd.startswith(f"cd {workdir}"):
            cmd = cmd[len(f"cd {workdir}"):].lstrip(" ;&")
        home = str(Path.home())
        cmd = cmd.replace(home, "~")
        cmd = " ".join(cmd.split())
        return f"terminal: {cmd}"

    if tool_name == "read_file":
        path = arguments.get("path", "")
        return f"read_file: {path}"

    if tool_name == "search_files":
        pattern = arguments.get("pattern", "")
        return f"search_files: {pattern}"

    if tool_name == "web_extract":
        urls = arguments.get("urls", [])
        if isinstance(urls, list):
            urls = tuple(sorted(urls))
        return f"web_extract: {urls}"

    if tool_name == "web_search":
        query = arguments.get("query", "")
        return f"web_search: {query}"

    keys = tuple(sorted(arguments.keys()))
    return f"{tool_name}({keys})"


def command_shape(tool_name, arguments):
    """Return an abstract command shape for grouping oversized results."""
    if not isinstance(arguments, dict):
        return f"{tool_name}: <unknown>"

    if tool_name == "terminal":
        cmd = arguments.get("command", "").strip()
        parts = cmd.split()
        base = parts[0] if parts else ""
        return f"terminal: {base} <args>"

    if tool_name == "read_file":
        path = arguments.get("path", "")
        ext = Path(path).suffix if path else ""
        return f"read_file: *{ext}" if ext else "read_file: <path>"

    if tool_name == "search_files":
        pattern = arguments.get("pattern", "")
        return f"search_files: {pattern}"

    if tool_name == "web_extract":
        return "web_extract: <urls>"

    if tool_name == "web_search":
        return "web_search: <query>"

    return f"{tool_name}: <args>"


def build_call_map(conn, session_ids=None):
    """Build a map of tool_call_id -> (tool_name, arguments, normalized, shape)."""
    where = "WHERE tool_calls IS NOT NULL"
    params = ()
    if session_ids:
        placeholders = ",".join("?" for _ in session_ids)
        where += f" AND session_id IN ({placeholders})"
        params = tuple(session_ids)

    call_map = {}
    cur = conn.execute(
        f"SELECT session_id, tool_calls FROM messages {where} ORDER BY id",
        params,
    )
    for row in cur:
        for call_id, tool_name, args in parse_tool_calls(row["tool_calls"]):
            if call_id:
                call_map[call_id] = {
                    "tool_name": tool_name,
                    "arguments": args,
                    "normalized": normalize_call(tool_name, args),
                    "shape": command_shape(tool_name, args),
                }
    return call_map


def mine_oversized(conn, threshold=SIZE_THRESHOLD):
    """Find tool results over threshold, grouped by tool_name and command_shape."""
    call_map = build_call_map(conn)

    cur = conn.execute(
        """
        SELECT session_id, tool_name, length(content) AS size, tool_call_id, id
        FROM messages
        WHERE role = 'tool' AND length(content) > ?
        ORDER BY session_id, id
        """,
        (threshold,),
    )

    groups = defaultdict(list)
    for row in cur:
        info = call_map.get(row["tool_call_id"], {})
        tool_name = row["tool_name"] or info.get("tool_name", "unknown")
        shape = info.get("shape", f"{tool_name}: <unknown>")
        groups[(tool_name, shape)].append({
            "session_id": row["session_id"],
            "size": row["size"],
            "message_id": row["id"],
        })

    findings = []
    for (tool_name, shape), items in groups.items():
        findings.append({
            "tool_name": tool_name,
            "command_shape": shape,
            "count": len(items),
            "total_size": sum(i["size"] for i in items),
            "max_size": max(i["size"] for i in items),
            "session_ids": sorted(set(i["session_id"] for i in items)),
        })

    findings.sort(key=lambda x: x["total_size"], reverse=True)
    return findings


def mine_repeats(conn, min_count=REPEAT_MIN_COUNT):
    """Find normalized commands run min_count+ times in one session."""
    cur = conn.execute(
        """
        SELECT session_id, id, tool_calls, _compressed_summary
        FROM messages
        WHERE role = 'assistant' AND tool_calls IS NOT NULL
        ORDER BY session_id, id
        """
    )

    by_session_normalized = defaultdict(list)
    compaction_points = {}

    for row in cur:
        sid = row["session_id"]
        if row["_compressed_summary"]:
            if sid not in compaction_points:
                compaction_points[sid] = row["id"]
            else:
                compaction_points[sid] = min(compaction_points[sid], row["id"])

        for call_id, tool_name, args in parse_tool_calls(row["tool_calls"]):
            normalized = normalize_call(tool_name, args)
            by_session_normalized[(sid, normalized)].append({
                "message_id": row["id"],
                "tool_name": tool_name,
            })

    findings = []
    for (sid, normalized), occurrences in by_session_normalized.items():
        if len(occurrences) < min_count:
            continue

        compaction_id = compaction_points.get(sid)
        if compaction_id:
            after_compaction = any(o["message_id"] > compaction_id for o in occurrences)
            before_compaction = any(o["message_id"] < compaction_id for o in occurrences)
            compaction_adjacent = after_compaction and before_compaction
        else:
            compaction_adjacent = False

        findings.append({
            "session_id": sid,
            "tool_name": occurrences[0]["tool_name"],
            "normalized_command": normalized,
            "count": len(occurrences),
            "compaction_adjacent": compaction_adjacent,
            "message_ids": [o["message_id"] for o in occurrences],
        })

    findings.sort(key=lambda x: x["count"], reverse=True)
    return findings


# ---------------------------------------------------------------------------
# Context-churn detector
# ---------------------------------------------------------------------------

def _state_db_sources(state_db_path, profile_dbs_dir):
    """Return [(label, path)] for the default state db and every profile state db."""
    sources = [("default", Path(state_db_path))]
    profile_dbs_dir = Path(profile_dbs_dir)
    if profile_dbs_dir.is_dir():
        for child in sorted(profile_dbs_dir.iterdir()):
            db = child / "state.db"
            if child.is_dir() and db.is_file():
                sources.append((child.name, db))
    return sources


def _first_user_message_map(conn):
    """Map session_id -> content of its earliest user message, in one scan."""
    out = {}
    cur = conn.execute(
        "SELECT m.session_id, m.content FROM messages m"
        " JOIN (SELECT session_id, MIN(id) AS mid FROM messages"
        "       WHERE role = 'user' GROUP BY session_id) t"
        " ON m.session_id = t.session_id AND m.id = t.mid"
    )
    for row in cur:
        out[row["session_id"]] = row["content"] or ""
    return out


def _board_task_titles(boards_dir):
    """Map task_id -> {\"title\", \"board\"} across every board db."""
    titles = {}
    boards_dir = Path(boards_dir)
    if not boards_dir.is_dir():
        return titles
    for board in sorted(boards_dir.iterdir()):
        db = board / "kanban.db"
        if not board.is_dir() or not db.is_file():
            continue
        try:
            conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
            try:
                for tid, title in conn.execute("SELECT id, title FROM tasks"):
                    titles.setdefault(tid, {"title": title, "board": board.name})
            finally:
                conn.close()
        except sqlite3.Error:
            continue
    return titles


def mine_context_churn(state_db_path, profile_dbs_dir, boards_dir):
    """Measure restart churn, resend amplification, and kanban_show refetch volume.

    Restart churn: group kanban worker sessions into cards via the first user
    message ('work kanban task t_x'); cards with CHURN_MIN_RUNS+ runs hold the
    tokens that tighter scoping or durable handoffs would avoid.
    Resend amplification: input-side tokens (fresh + cache read + cache write)
    per output token, per session. Every turn resends the whole conversation,
    so a high ratio marks runs where the context did the spending.
    kanban_show refetch: card bodies and handoffs re-fetched mid-run land in
    context and are resent on every later turn.
    """
    finding = {
        "note": None,
        "dbs_scanned": [],
        "sessions_with_usage": 0,
        "kanban_sessions": 0,
        "cards_seen": 0,
        "multi_run": {"min_runs": CHURN_MIN_RUNS, "cards": 0, "tokens": 0,
                      "token_share_pct": 0.0, "top_cards": []},
        "amplification": {"min_ratio": AMPLIFY_MIN_RATIO, "median_ratio": 0.0,
                          "sessions_above": 0, "worst_sessions": []},
        "kanban_show_refetch": {"calls": 0, "sessions_with_multiple": 0,
                                "approx_tokens": 0},
        "proposals": [],
    }

    cards = defaultdict(lambda: {"runs": 0, "tokens": 0, "profiles": set()})
    ratios = []
    worst = []
    total_card_tokens = 0
    ks_calls = 0
    ks_chars = 0
    ks_multi = 0

    for label, db in _state_db_sources(state_db_path, profile_dbs_dir):
        conn, note = connect_db(db)
        if conn is None:
            continue
        try:
            finding["dbs_scanned"].append(label)
            sessions = conn.execute(
                "SELECT id, source, input_tokens, output_tokens,"
                " cache_read_tokens, cache_write_tokens FROM sessions"
                " WHERE input_tokens + cache_read_tokens + cache_write_tokens > 0"
            ).fetchall()
            finding["sessions_with_usage"] += len(sessions)
            first_user = _first_user_message_map(conn)
            for s in sessions:
                in_side = (s["input_tokens"] or 0) + (s["cache_read_tokens"] or 0) \
                    + (s["cache_write_tokens"] or 0)
                out = s["output_tokens"] or 0
                ratio = in_side / max(out, 1)
                ratios.append(ratio)
                if ratio >= AMPLIFY_MIN_RATIO and in_side >= AMPLIFY_MIN_INPUT_SIDE:
                    worst.append({
                        "session_id": s["id"], "db": label,
                        "input_side_tokens": in_side, "output_tokens": out,
                        "ratio": round(ratio, 1),
                    })
                task = KANBAN_TASK_RE.search(first_user.get(s["id"], ""))
                if task:
                    finding["kanban_sessions"] += 1
                    c = cards[task.group(1)]
                    c["runs"] += 1
                    c["tokens"] += in_side + out
                    c["profiles"].add(label)
                    total_card_tokens += in_side + out
            ks = conn.execute(
                "SELECT session_id, COUNT(*) AS n,"
                " SUM(LENGTH(COALESCE(content, ''))) AS chars"
                " FROM messages WHERE role = 'tool' AND tool_name = 'kanban_show'"
                " GROUP BY session_id"
            ).fetchall()
            for row in ks:
                ks_calls += row["n"]
                ks_chars += row["chars"] or 0
                if row["n"] > 1:
                    ks_multi += 1
        except sqlite3.Error:
            continue
        finally:
            conn.close()

    finding["cards_seen"] = len(cards)
    multi = sorted((c for c in cards.items() if c[1]["runs"] >= CHURN_MIN_RUNS),
                   key=lambda kv: -kv[1]["tokens"])
    multi_tokens = sum(c["tokens"] for _, c in multi)
    finding["multi_run"]["cards"] = len(multi)
    finding["multi_run"]["tokens"] = multi_tokens
    if total_card_tokens:
        finding["multi_run"]["token_share_pct"] = round(
            multi_tokens / total_card_tokens * 100, 1)
    titles = _board_task_titles(boards_dir)
    finding["multi_run"]["top_cards"] = [
        {"task_id": tid,
         "title": titles.get(tid, {}).get("title"),
         "board": titles.get(tid, {}).get("board"),
         "runs": c["runs"], "tokens": c["tokens"],
         "profiles": sorted(c["profiles"])}
        for tid, c in multi[:15]
    ]

    ratios.sort()
    if ratios:
        finding["amplification"]["median_ratio"] = round(
            ratios[len(ratios) // 2], 1)
    finding["amplification"]["sessions_above"] = len(worst)
    finding["amplification"]["worst_sessions"] = sorted(
        worst, key=lambda w: -w["input_side_tokens"])[:15]

    finding["kanban_show_refetch"] = {
        "calls": ks_calls,
        "sessions_with_multiple": ks_multi,
        "approx_tokens": ks_chars // 4,
    }

    if not finding["dbs_scanned"]:
        finding["note"] = "no readable state dbs found"
        return finding

    if multi:
        finding["proposals"].append(
            f"{len(multi)} cards with {CHURN_MIN_RUNS}+ runs hold "
            f"{finding['multi_run']['token_share_pct']}% of card tokens. "
            "Route repeatedly blocked cards to triage earlier and persist "
            "worker findings in durable handoff notes so a restart does not "
            "re-read the same files."
        )
    if ks_calls:
        finding["proposals"].append(
            f"kanban_show returned ~{ks_chars // 4:,} tokens across {ks_calls:,} "
            f"calls ({ks_multi:,} sessions fetched it more than once). Cap the "
            "handoff history in worker_context or cache the card body in the "
            "task workspace."
        )
    if worst:
        finding["proposals"].append(
            f"{len(worst)} sessions exceed {AMPLIFY_MIN_RATIO}x input-to-output. "
            "Turn budgets and smaller tool results bend the turns-times-context "
            "curve that drives this."
        )
    return finding


# ---------------------------------------------------------------------------
# Unused-skills detector
# ---------------------------------------------------------------------------

def parse_skill_frontmatter(text):
    """Extract name and description from SKILL.md frontmatter.

    Returns (name, description) or (None, None) on failure.
    """
    if not text.startswith("---"):
        return None, None
    end = text.find("---", 3)
    if end == -1:
        return None, None
    frontmatter = text[3:end].strip()
    name = None
    description = None
    for line in frontmatter.splitlines():
        line = line.rstrip()
        if line.startswith("name:"):
            name = line.split(":", 1)[1].strip().strip('"').strip("'")
        elif line.startswith("description:"):
            description = line.split(":", 1)[1].strip().strip('"').strip("'")
    return name, description


def enumerate_skills(skills_dir):
    """Return a dict of skill_name -> {"path": Path, "catalog_cost": int}."""
    skills = {}
    if not skills_dir.exists():
        return skills
    for skill_md in skills_dir.rglob("SKILL.md"):
        text = skill_md.read_text(encoding="utf-8")
        name, description = parse_skill_frontmatter(text)
        if name:
            cost = len(name) + len(description or "")
            skills[name] = {
                "path": str(skill_md),
                "catalog_cost": cost,
            }
    return skills


def _skill_names_from_tool_calls(tool_calls_json, skills_dir):
    """Return a set of skill names referenced in tool_calls."""
    used = set()
    home = str(Path.home())
    skills_dir_str = str(skills_dir)
    for _, tool_name, args in parse_tool_calls(tool_calls_json):
        if tool_name in ("skill_view", "skill_manage"):
            if isinstance(args, dict):
                if tool_name == "skill_view":
                    name = args.get("name")
                    if name:
                        used.add(name)
                elif tool_name == "skill_manage":
                    ops = args.get("operations", [])
                    if isinstance(ops, list):
                        for op in ops:
                            if isinstance(op, dict):
                                name = op.get("name")
                                if name:
                                    used.add(name)
        elif tool_name in ("read_file", "patch", "search_files"):
            if isinstance(args, dict):
                path = args.get("path", "")
                if path:
                    resolved = str(Path(path).expanduser().resolve())
                    if resolved.startswith(skills_dir_str):
                        # Extract skill name from path: .../skills/<name>/SKILL.md or subdirectory
                        rel = Path(resolved).relative_to(skills_dir_str)
                        parts = rel.parts
                        if parts:
                            used.add(parts[0])
        elif tool_name == "write_file":
            if isinstance(args, dict):
                path = args.get("path", "")
                if path:
                    resolved = str(Path(path).expanduser().resolve())
                    if resolved.startswith(skills_dir_str):
                        rel = Path(resolved).relative_to(skills_dir_str)
                        parts = rel.parts
                        if parts:
                            used.add(parts[0])
    return used


def _collect_used_skills_from_db(db_path, skills_dir):
    """Return a set of skill names used in a single state db."""
    used = set()
    conn, _ = connect_db(db_path)
    if conn is None:
        return used
    try:
        cur = conn.execute(
            """
            SELECT tool_calls FROM messages
            WHERE role = 'assistant' AND tool_calls IS NOT NULL
            """
        )
        for row in cur:
            used |= _skill_names_from_tool_calls(row["tool_calls"], skills_dir)
    finally:
        conn.close()
    return used


def _collect_referenced_skills_from_hooks(hooks_dir):
    """Return a set of skill names mentioned in agent-hooks files."""
    referenced = set()
    if not hooks_dir.exists():
        return referenced
    for path in hooks_dir.iterdir():
        if path.is_file() and not path.name.startswith("."):
            try:
                text = path.read_text(encoding="utf-8", errors="ignore")
            except (OSError, UnicodeDecodeError):
                continue
            # We will match skill names against this text later.
            # For now, just store the text; the caller has the skill list.
            referenced.add(("hook", path.name, text))
    return referenced


def _collect_referenced_skills_from_scripts(scripts_dir):
    """Return a set of skill names mentioned in scripts files."""
    referenced = set()
    if not scripts_dir.exists():
        return referenced
    for path in scripts_dir.iterdir():
        if path.is_file() and not path.name.startswith("."):
            try:
                text = path.read_text(encoding="utf-8", errors="ignore")
            except (OSError, UnicodeDecodeError):
                continue
            referenced.add(("script", path.name, text))
    return referenced


def _collect_referenced_skills_from_boards(boards_dir):
    """Return a set of skill names pinned in kanban card skills columns."""
    referenced = set()
    if not boards_dir.exists():
        return referenced
    for board_path in boards_dir.iterdir():
        db_file = board_path / "kanban.db"
        if not db_file.exists():
            continue
        conn, _ = connect_db(db_file)
        if conn is None:
            continue
        try:
            cur = conn.execute(
                "SELECT name FROM sqlite_master WHERE type='table' AND name='tasks'"
            )
            if not cur.fetchone():
                continue
            cur = conn.execute("SELECT skills FROM tasks WHERE skills IS NOT NULL")
            for row in cur:
                try:
                    skills = json.loads(row["skills"])
                    if isinstance(skills, list):
                        for name in skills:
                            if isinstance(name, str):
                                referenced.add(name)
                except (ValueError, TypeError):
                    pass
        finally:
            conn.close()
    return referenced


def mine_unused_skills(
    skills_dir,
    state_db_path,
    profile_dbs_dir,
    agent_hooks_dir,
    scripts_dir,
    boards_dir,
):
    """Find installed skills that are neither used nor referenced."""
    skills = enumerate_skills(skills_dir)
    if not skills:
        return {
            "total_skills": 0,
            "used_count": 0,
            "referenced_count": 0,
            "never_used_count": 0,
            "total_catalog_cost": 0,
            "never_used_cost": 0,
            "skills": [],
            "note": f"no skills found in {skills_dir}",
        }

    used = _collect_used_skills_from_db(state_db_path, skills_dir)

    # Aggregate profile dbs
    if profile_dbs_dir.exists():
        for profile_dir in profile_dbs_dir.iterdir():
            profile_db = profile_dir / "state.db"
            if profile_db.exists():
                used |= _collect_used_skills_from_db(profile_db, skills_dir)

    # Reference signals
    referenced = set()
    hook_refs = _collect_referenced_skills_from_hooks(agent_hooks_dir)
    script_refs = _collect_referenced_skills_from_scripts(scripts_dir)
    board_refs = _collect_referenced_skills_from_boards(boards_dir)

    # Match skill names against hook/script text
    all_skill_names = set(skills.keys())
    for _, _, text in hook_refs:
        for name in all_skill_names:
            if name in text:
                referenced.add(name)
    for _, _, text in script_refs:
        for name in all_skill_names:
            if name in text:
                referenced.add(name)
    referenced |= board_refs

    never_used = []
    total_cost = sum(s["catalog_cost"] for s in skills.values())
    never_used_cost = 0

    for name, info in sorted(skills.items(), key=lambda x: x[1]["catalog_cost"], reverse=True):
        is_used = name in used
        is_referenced = name in referenced
        is_keep = name in KEEP_LIST
        if not is_used and not is_referenced and not is_keep:
            never_used.append({
                "name": name,
                "catalog_cost": info["catalog_cost"],
                "path": info["path"],
            })
            never_used_cost += info["catalog_cost"]

    # Keep-list items are reported separately so they stay visible
    keep_items = []
    for name in sorted(KEEP_LIST):
        if name in skills:
            keep_items.append({
                "name": name,
                "catalog_cost": skills[name]["catalog_cost"],
            })

    return {
        "total_skills": len(skills),
        "used_count": len(used & all_skill_names),
        "referenced_count": len(referenced & all_skill_names),
        "keep_count": len(keep_items),
        "never_used_count": len(never_used),
        "total_catalog_cost": total_cost,
        "never_used_cost": never_used_cost,
        "skills": never_used,
        "keep_list": keep_items,
        "note": None,
    }


# ---------------------------------------------------------------------------
# Domain-fit detector
# ---------------------------------------------------------------------------

def _default_domain_map():
    """The map is per-user config: it names your own profiles, skills, and repos."""
    config_home = os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config"
    return Path(config_home) / "clearstack" / "domain-map.yaml"


DEFAULT_DOMAIN_MAP = _default_domain_map()


def load_domain_map(path):
    """Load and parse the domain map YAML.

    Returns (domain_map_dict, error_string).  The dict has keys:
      version: int
      domains: dict of domain_name -> {
          profiles: list[str],
          skills: set[str],
          signals: list[compiled_regex],
      }
    Also adds derived lookups:
      profile_domain: dict of profile_name -> domain_name
      assigned_profiles: set of profile names that belong to a domain
    """
    if not path.exists():
        return None, f"domain map not found at {path}"
    try:
        text = path.read_text(encoding="utf-8")
        data = _yaml_safe_load(text)
    except Exception as e:
        return None, f"could not parse domain map: {e}"

    if not isinstance(data, dict):
        return None, "domain map root is not a dict"

    raw_domains = data.get("domains", {})
    if not isinstance(raw_domains, dict):
        return None, "domain map 'domains' key is not a dict"

    domains = {}
    profile_domain = {}
    assigned_profiles = set()

    for domain_name, domain_info in raw_domains.items():
        if not isinstance(domain_info, dict):
            continue
        profiles = domain_info.get("profiles", []) or []
        skills = set(domain_info.get("skills", []) or [])
        signals = []
        for pattern in domain_info.get("signals", []) or []:
            try:
                signals.append(re.compile(pattern))
            except re.error:
                continue
        domains[domain_name] = {
            "profiles": profiles,
            "skills": skills,
            "signals": signals,
        }
        for profile in profiles:
            profile_domain[profile] = domain_name
            assigned_profiles.add(profile)

    return {
        "version": data.get("version", 1),
        "domains": domains,
        "profile_domain": profile_domain,
        "assigned_profiles": assigned_profiles,
    }, None


def _domain_for_skill(skill_name, domains):
    """Return the domain name that owns a skill, or None."""
    for domain_name, info in domains.items():
        if skill_name in info["skills"]:
            return domain_name
    return None


def _collect_cross_domain_skill_use(db_path, domains, profile_domain, skills_dir):
    """Return list of cross-domain skill use findings from a single state db."""
    findings = []
    conn, _ = connect_db(db_path)
    if conn is None:
        return findings
    try:
        cur = conn.execute(
            """
            SELECT session_id, id, tool_calls FROM messages
            WHERE role = 'assistant' AND tool_calls IS NOT NULL
            """
        )
        for row in cur:
            for _, tool_name, args in parse_tool_calls(row["tool_calls"]):
                skill_name = None
                if tool_name == "skill_view" and isinstance(args, dict):
                    skill_name = args.get("name")
                elif tool_name == "skill_manage" and isinstance(args, dict):
                    ops = args.get("operations", [])
                    if isinstance(ops, list):
                        for op in ops:
                            if isinstance(op, dict):
                                skill_name = op.get("name")
                                if skill_name:
                                    break
                if not skill_name:
                    continue
                skill_domain = _domain_for_skill(skill_name, domains)
                if skill_domain and skill_domain != profile_domain and skill_domain != "shared":
                    findings.append({
                        "session_id": row["session_id"],
                        "message_id": row["id"],
                        "skill": skill_name,
                        "skill_domain": skill_domain,
                    })
    finally:
        conn.close()
    return findings


def _collect_cross_domain_signals(db_path, domains, profile_domain):
    """Return dict of foreign_domain -> list of hit findings from terminal history."""
    hits = defaultdict(list)
    conn, _ = connect_db(db_path)
    if conn is None:
        return hits
    try:
        cur = conn.execute(
            """
            SELECT session_id, id, tool_calls FROM messages
            WHERE role = 'assistant' AND tool_calls IS NOT NULL
            """
        )
        for row in cur:
            for _, tool_name, args in parse_tool_calls(row["tool_calls"]):
                if tool_name != "terminal" or not isinstance(args, dict):
                    continue
                cmd = args.get("command", "")
                if not isinstance(cmd, str):
                    continue
                for domain_name, info in domains.items():
                    if domain_name == profile_domain or domain_name == "shared":
                        continue
                    for rx in info["signals"]:
                        if rx.search(cmd):
                            hits[domain_name].append({
                                "session_id": row["session_id"],
                                "message_id": row["id"],
                                "command": cmd,
                                "matched_signal": rx.pattern,
                            })
                            break
    finally:
        conn.close()
    return hits


LIVE_STATUSES = {"triage", "todo", "ready", "running", "blocked", "review"}


def _collect_routing_mismatches(boards_dir, domains, profile_domain_map):
    """Return list of live kanban cards whose signals match a foreign domain.

    Rules:
    - Only cards in live statuses are checked.
    - Unmapped assignees and generalist/review lanes are skipped.
    - At most one flag per card: the domain with the most signal hits.
    """
    findings = []
    if not boards_dir.exists():
        return findings

    for board_path in boards_dir.iterdir():
        db_file = board_path / "kanban.db"
        if not db_file.exists():
            continue
        conn, _ = connect_db(db_file)
        if conn is None:
            continue
        try:
            cur = conn.execute(
                "SELECT name FROM sqlite_master WHERE type='table' AND name='tasks'"
            )
            if not cur.fetchone():
                continue
            cur = conn.execute(
                "SELECT id, title, body, assignee, status FROM tasks WHERE assignee IS NOT NULL"
            )
            for row in cur:
                status = row["status"] or ""
                if status not in LIVE_STATUSES:
                    continue
                assignee = row["assignee"]
                assignee_domain = profile_domain_map.get(assignee)
                if assignee_domain is None or assignee_domain in ("generalist", "review"):
                    continue

                text = f"{row['title'] or ''}\n{row['body'] or ''}"
                domain_hits = {}
                for domain_name, info in domains.items():
                    if domain_name == assignee_domain or domain_name == "shared":
                        continue
                    hit_count = 0
                    for rx in info["signals"]:
                        if rx.search(text):
                            hit_count += 1
                    if hit_count > 0:
                        domain_hits[domain_name] = hit_count

                if not domain_hits:
                    continue

                # Pick the domain with the most signal hits (alphabetic tie-break).
                best_domain = max(domain_hits, key=lambda d: (domain_hits[d], d))
                other_count = len(domain_hits) - 1

                findings.append({
                    "board": board_path.name,
                    "task_id": row["id"],
                    "matched_domain": best_domain,
                    "other_matches": other_count,
                    "assignee": assignee,
                    "assignee_domain": assignee_domain,
                })
        finally:
            conn.close()
    return findings


def mine_domain_fit(
    domain_map_path,
    skills_dir,
    state_db_path,
    profile_dbs_dir,
    boards_dir,
):
    """Audit whether profiles stay in their assigned domains."""
    domain_map, error = load_domain_map(domain_map_path)
    if error:
        return {"note": error, "profiles": [], "domain_pressure": []}

    domains = domain_map["domains"]
    profile_domain_map = domain_map["profile_domain"]
    assigned = domain_map["assigned_profiles"]
    all_skills = enumerate_skills(skills_dir)

    profile_results = []
    domain_pressure = defaultdict(int)

    # Audit default profile (state_db_path)
    profile_dbs = [("default", state_db_path)]

    if profile_dbs_dir.exists():
        for profile_dir in profile_dbs_dir.iterdir():
            profile_db = profile_dir / "state.db"
            if profile_db.exists():
                profile_dbs.append((profile_dir.name, profile_db))

    for profile_name, db_path in profile_dbs:
        domain_name = profile_domain_map.get(profile_name)
        if domain_name is None or domain_name == "generalist":
            # Generalist: never flagged, but contributes to domain pressure
            cross_skill = []
            cross_signals = defaultdict(list)
            used_skills = set()
            domain_skills = set()
        else:
            domain_skills = domains[domain_name]["skills"]
            used_skills = _collect_used_skills_from_db(db_path, skills_dir)
            cross_skill = _collect_cross_domain_skill_use(
                db_path, domains, domain_name, skills_dir
            )
            cross_signals = _collect_cross_domain_signals(db_path, domains, domain_name)

            # Add unassigned-domain signal hits to domain pressure
            for foreign_domain, hits in cross_signals.items():
                if foreign_domain == "shared":
                    continue
                if foreign_domain not in profile_domain_map.values():
                    domain_pressure[foreign_domain] += len(hits)

        # Compute catalog cost for used vs unused domain skills
        used_domain_skills = used_skills & domain_skills
        unused_domain_skills = domain_skills - used_skills
        used_cost = sum(
            all_skills[s]["catalog_cost"] for s in used_domain_skills if s in all_skills
        )
        unused_cost = sum(
            all_skills[s]["catalog_cost"] for s in unused_domain_skills if s in all_skills
        )

        profile_results.append({
            "profile": profile_name,
            "domain": domain_name,
            "domain_skills_count": len(domain_skills),
            "used_domain_skills_count": len(used_domain_skills),
            "unused_domain_skills_count": len(unused_domain_skills),
            "used_domain_cost": used_cost,
            "unused_domain_cost": unused_cost,
            "cross_domain_skill_use": cross_skill,
            "cross_domain_signals": dict(cross_signals),
        })

    # Also scan generalist profiles for unassigned-domain pressure
    for profile_name, db_path in profile_dbs:
        if profile_name in assigned:
            continue
        generalist_signals = _collect_cross_domain_signals(db_path, domains, None)
        for foreign_domain, hits in generalist_signals.items():
            if foreign_domain == "shared":
                continue
            if foreign_domain not in profile_domain_map.values():
                domain_pressure[foreign_domain] += len(hits)

    # Domain pressure ranking
    pressure_list = sorted(
        [{"domain": d, "hits": h} for d, h in domain_pressure.items()],
        key=lambda x: x["hits"],
        reverse=True,
    )

    # Routing mismatches across all boards
    routing_mismatches = _collect_routing_mismatches(boards_dir, domains, profile_domain_map)

    return {
        "note": None,
        "map_version": domain_map["version"],
        "map_path": str(domain_map_path),
        "profiles": profile_results,
        "domain_pressure": pressure_list,
        "routing_mismatches": routing_mismatches,
    }


# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------

def _compact_number(value):
    """Format an integer compactly enough for a chat summary."""
    if value >= 1_000_000:
        return f"{value / 1_000_000:.2f}".rstrip("0").rstrip(".") + "M"
    if value >= 1_000:
        return f"{value / 1_000:.1f}".rstrip("0").rstrip(".") + "K"
    return str(value)


def _discord_code(value):
    """Render a bounded single-line Discord inline code span."""
    text = " ".join(str(value).split()).replace("`", "'")
    if len(text) > DISCORD_LABEL_LIMIT:
        text = text[:DISCORD_LABEL_LIMIT - 1] + "…"
    return f"`{text}`"


def _discord_section(lines, heading, entries, total):
    """Append one compact, bounded finding section."""
    lines.append(heading)
    lines.extend(entries[:DISCORD_ITEMS_PER_SECTION])
    remaining = total - min(len(entries), DISCORD_ITEMS_PER_SECTION)
    if remaining:
        lines.append(f"- {remaining:,} more")


def _discord_oversized_label(finding):
    """Keep command-shape context without repeating the tool name."""
    tool_name = finding["tool_name"]
    shape = finding["command_shape"]
    prefix = f"{tool_name}: "
    detail = shape[len(prefix):] if shape.startswith(prefix) else shape
    detail = detail.removesuffix(" <args>")
    return tool_name if detail in ("", "<args>") else f"{tool_name} {detail}"


def _discord_domain_fit(domain_fit):
    note = domain_fit.get("note")
    if note:
        return f"**Domain fit**: {note}"

    profiles = domain_fit.get("profiles", [])
    cross_skills = sum(len(p["cross_domain_skill_use"]) for p in profiles)
    cross_signals = sum(
        len(signals)
        for p in profiles
        for signals in p["cross_domain_signals"].values()
    )
    mismatches = len(domain_fit.get("routing_mismatches", []))
    return (
        f"**Domain fit**: {len(profiles)} profiles, {cross_skills} cross-domain skill uses, "
        f"{cross_signals} signal hits, {mismatches} routing mismatches"
    )


def _discord_lane_ideation(lane_ideation_data):
    note = lane_ideation_data.get("note")
    if note:
        return [f"**Lane ideation**: {note}"]

    candidates = lane_ideation_data.get("candidates", [])
    lines = [f"**Lane ideation**: {len(candidates)} candidates"]
    for candidate in candidates[:DISCORD_ITEMS_PER_SECTION]:
        lines.append(
            f"- {_discord_code(candidate['name'])}: {candidate['session_count']} sessions, "
            f"{_compact_number(candidate['tokens'])} tokens"
        )
    remaining = len(candidates) - min(len(candidates), DISCORD_ITEMS_PER_SECTION)
    if remaining:
        lines.append(f"- {remaining:,} more")
    return lines


def _discord_context_churn(context_churn):
    note = context_churn.get("note")
    if note:
        return f"**Context churn**: {note}"

    restart = context_churn["multi_run"]
    amplification = context_churn["amplification"]
    refetch = context_churn["kanban_show_refetch"]
    return (
        f"**Context churn**: {restart['cards']} restarted cards, "
        f"{amplification['sessions_above']} sessions above {amplification['min_ratio']}x resend, "
        f"{refetch['calls']:,} kanban refetches"
    )


def emit_discord_summary(oversized, repeats, unused, domain_fit,
                         lane_ideation_data, context_churn=None):
    """Return a compact Markdown report that fits in one Discord message."""
    lines = []
    oversized_entries = [
        (
            f"- {_discord_code(_discord_oversized_label(f))} x{f['count']}, "
            f"{_compact_number(f['total_size'])} total, "
            f"{_compact_number(f['max_size'])} max"
        )
        for f in sorted(oversized, key=lambda f: (f["total_size"], f["count"]), reverse=True)
    ]
    _discord_section(
        lines,
        f"**Oversized results** ({len(oversized)} patterns over {SIZE_THRESHOLD:,} chars)",
        oversized_entries,
        len(oversized),
    )

    lines.append("")
    repeat_entries = [
        (
            f"- {_discord_code(f['normalized_command'])} x{f['count']} in "
            f"{_discord_code(f['session_id'])}"
            f"{' (after compaction)' if f['compaction_adjacent'] else ''}"
        )
        for f in sorted(repeats, key=lambda f: f["count"], reverse=True)
    ]
    _discord_section(
        lines,
        f"**Repeated commands** ({len(repeats)} patterns)",
        repeat_entries,
        len(repeats),
    )

    lines.append("")
    note = unused.get("note")
    if note:
        lines.append(f"**Unused skills**: {note}")
    else:
        unused_entries = [
            f"- {_discord_code(skill['name'])}, {skill['catalog_cost']:,} chars"
            for skill in unused["skills"]
        ]
        _discord_section(
            lines,
            (
                f"**Unused skills** ({unused['never_used_count']} of {unused['total_skills']}, "
                f"{unused['never_used_cost']:,} / {unused['total_catalog_cost']:,} catalog chars)"
            ),
            unused_entries,
            unused["never_used_count"],
        )

    lines.extend(["", _discord_domain_fit(domain_fit), ""])
    lines.extend(_discord_lane_ideation(lane_ideation_data))
    if context_churn is not None:
        lines.extend(["", _discord_context_churn(context_churn)])

    summary = "\n".join(lines)
    if len(summary) <= DISCORD_MESSAGE_LIMIT:
        return summary
    return summary[:DISCORD_MESSAGE_LIMIT - 16].rstrip() + "\n… truncated"


def emit_summary(oversized, repeats, unused, domain_fit, lane_ideation_data,
                 context_churn=None):
    """Return a short human-readable summary string."""
    lines = []
    lines.append(
        f"Oversized tool results (>{SIZE_THRESHOLD} chars): {len(oversized)} finding(s)"
    )
    for f in oversized[:10]:
        lines.append(
            f"  {f['tool_name']}: {f['command_shape']} — {f['count']} call(s), "
            f"max {f['max_size']:,} chars, total {f['total_size']:,} chars"
        )
    if len(oversized) > 10:
        lines.append(f"  ... and {len(oversized) - 10} more")

    lines.append("")
    lines.append(
        f"Repeated commands ({REPEAT_MIN_COUNT}+ in one session): {len(repeats)} finding(s)"
    )
    for f in repeats[:10]:
        adj = " (compaction-adjacent)" if f["compaction_adjacent"] else ""
        lines.append(
            f"  {f['normalized_command']} — {f['count']} times in {f['session_id']}{adj}"
        )
    if len(repeats) > 10:
        lines.append(f"  ... and {len(repeats) - 10} more")

    lines.append("")
    note = unused.get("note")
    if note:
        lines.append(f"Unused skills: {note}")
    else:
        lines.append(
            f"Unused skills: {unused['never_used_count']} of {unused['total_skills']} "
            f"({unused['never_used_cost']:,} / {unused['total_catalog_cost']:,} catalog chars)"
        )
        for s in unused["skills"][:10]:
            lines.append(f"  {s['name']} — {s['catalog_cost']:,} chars")
        if len(unused["skills"]) > 10:
            lines.append(f"  ... and {len(unused['skills']) - 10} more")
        if unused["keep_list"]:
            lines.append(f"  keep list: {', '.join(k['name'] for k in unused['keep_list'])}")

    # Domain fit
    lines.append("")
    note = domain_fit.get("note")
    if note:
        lines.append(f"Domain fit: {note}")
    else:
        lines.append("Domain fit:")
        for p in domain_fit["profiles"]:
            domain_label = p["domain"] or "generalist"
            cross_skill = len(p["cross_domain_skill_use"])
            cross_sig = sum(len(v) for v in p["cross_domain_signals"].values())
            lines.append(
                f"  {p['profile']} ({domain_label}) — "
                f"{p['used_domain_skills_count']}/{p['domain_skills_count']} skills used, "
                f"{cross_skill} cross-domain skill use, {cross_sig} cross-domain signal hits"
            )
        if domain_fit["domain_pressure"]:
            lines.append("  Domain pressure (unassigned domains):")
            for dp in domain_fit["domain_pressure"][:5]:
                lines.append(f"    {dp['domain']}: {dp['hits']} signal hit(s)")
        if domain_fit["routing_mismatches"]:
            lines.append(f"  Routing mismatches: {len(domain_fit['routing_mismatches'])} finding(s)")
            for rm in domain_fit["routing_mismatches"][:5]:
                extra = f" (+{rm['other_matches']} other)" if rm.get("other_matches", 0) > 0 else ""
                lines.append(
                    f"    {rm['task_id']} on {rm['board']} — "
                    f"matches {rm['matched_domain']}{extra}, assigned to {rm['assignee']}"
                )

    # Lane ideation
    lines.append("")
    lines.append(lane_ideation.format_lane_ideation_summary(lane_ideation_data))

    # Context churn
    if context_churn is not None:
        lines.append("")
        note = context_churn.get("note")
        if note:
            lines.append(f"Context churn: {note}")
        else:
            mr = context_churn["multi_run"]
            amp = context_churn["amplification"]
            ks = context_churn["kanban_show_refetch"]
            lines.append(
                f"Context churn: {context_churn['kanban_sessions']} kanban runs, "
                f"{context_churn['cards_seen']} cards"
            )
            lines.append(
                f"  restart churn: {mr['cards']} cards with {mr['min_runs']}+ runs "
                f"hold {mr['token_share_pct']}% of card tokens"
            )
            for c in mr["top_cards"][:5]:
                title = (c["title"] or "")[:60]
                lines.append(
                    f"    {c['task_id']} — {c['runs']} runs, "
                    f"{c['tokens']:,} tok — {title}"
                )
            lines.append(
                f"  resend amplification: median {amp['median_ratio']}x "
                f"input-to-output, {amp['sessions_above']} sessions above "
                f"{amp['min_ratio']}x"
            )
            lines.append(
                f"  kanban_show refetch: {ks['calls']:,} calls, ~{ks['approx_tokens']:,} tok, "
                f"{ks['sessions_with_multiple']:,} sessions fetched more than once"
            )
            for p in context_churn["proposals"]:
                lines.append(f"  proposal: {p}")

    return "\n".join(lines)


def mine(state_db_path, runs_path, skills_dir=None, agent_hooks_dir=None,
         scripts_dir=None, boards_dir=None, profile_dbs_dir=None,
         domain_map_path=None):
    """Run all detectors and return the full report dict."""
    report = {
        "generated_at": None,
        "sources": {},
        "findings": {
            "oversized_results": [],
            "repeated_commands": [],
            "unused_skills": {},
            "domain_fit": {},
            "context_churn": {},
        },
        "summary": "",
    }

    conn, note = connect_db(state_db_path)
    if conn is None:
        report["sources"]["state_db"] = {"path": str(state_db_path), "note": note}
    else:
        report["sources"]["state_db"] = {"path": str(state_db_path), "note": None}
        try:
            report["findings"]["oversized_results"] = mine_oversized(conn)
            report["findings"]["repeated_commands"] = mine_repeats(conn)
        finally:
            conn.close()

    if runs_path.exists():
        report["sources"]["runs_jsonl"] = {"path": str(runs_path), "note": None}
    else:
        report["sources"]["runs_jsonl"] = {"path": str(runs_path), "note": "not found"}

    skills_dir = skills_dir or DEFAULT_SKILLS_DIR
    agent_hooks_dir = agent_hooks_dir or DEFAULT_AGENT_HOOKS_DIR
    scripts_dir = scripts_dir or DEFAULT_SCRIPTS_DIR
    boards_dir = boards_dir or DEFAULT_KANBAN_BOARDS_DIR
    profile_dbs_dir = profile_dbs_dir or (Path.home() / ".hermes" / "profiles")
    domain_map_path = domain_map_path or DEFAULT_DOMAIN_MAP

    report["findings"]["unused_skills"] = mine_unused_skills(
        skills_dir,
        state_db_path,
        profile_dbs_dir,
        agent_hooks_dir,
        scripts_dir,
        boards_dir,
    )

    report["findings"]["domain_fit"] = mine_domain_fit(
        domain_map_path,
        skills_dir,
        state_db_path,
        profile_dbs_dir,
        boards_dir,
    )

    domain_map, _ = load_domain_map(domain_map_path)
    report["findings"]["lane_ideation"] = lane_ideation.mine_lane_ideation(
        domain_map, state_db_path, profile_dbs_dir
    )

    report["findings"]["context_churn"] = mine_context_churn(
        state_db_path, profile_dbs_dir, boards_dir
    )

    report["summary"] = emit_summary(
        report["findings"]["oversized_results"],
        report["findings"]["repeated_commands"],
        report["findings"]["unused_skills"],
        report["findings"]["domain_fit"],
        report["findings"]["lane_ideation"],
        report["findings"]["context_churn"],
    )
    return report


def main():
    parser = argparse.ArgumentParser(
        prog="mine",
        description="Mine agent history for repeated waste and propose guards.",
    )
    parser.add_argument(
        "--db",
        type=Path,
        default=DEFAULT_STATE_DB,
        help="Path to Hermes state.db",
    )
    parser.add_argument(
        "--runs",
        type=Path,
        default=DEFAULT_RUNS_LOG,
        help="Path to clearstack runs.jsonl",
    )
    parser.add_argument(
        "--skills-dir",
        type=Path,
        default=DEFAULT_SKILLS_DIR,
        help="Path to Hermes skills directory",
    )
    parser.add_argument(
        "--agent-hooks-dir",
        type=Path,
        default=DEFAULT_AGENT_HOOKS_DIR,
        help="Path to agent-hooks directory",
    )
    parser.add_argument(
        "--scripts-dir",
        type=Path,
        default=DEFAULT_SCRIPTS_DIR,
        help="Path to scripts directory",
    )
    parser.add_argument(
        "--boards-dir",
        type=Path,
        default=DEFAULT_KANBAN_BOARDS_DIR,
        help="Path to kanban boards directory",
    )
    parser.add_argument(
        "--domain-map",
        type=Path,
        default=DEFAULT_DOMAIN_MAP,
        help="Path to domain map YAML",
    )
    parser.add_argument(
        "--output",
        type=Path,
        help="Write output to this file",
    )
    parser.add_argument(
        "--format",
        choices=["json", "summary", "discord", "both"],
        default="both",
        help="Output format",
    )
    args = parser.parse_args()

    report = mine(
        args.db,
        args.runs,
        skills_dir=args.skills_dir,
        agent_hooks_dir=args.agent_hooks_dir,
        scripts_dir=args.scripts_dir,
        boards_dir=args.boards_dir,
        domain_map_path=args.domain_map,
    )
    report["generated_at"] = datetime.now(timezone.utc).isoformat()

    if args.format in ("json", "both"):
        json_out = json.dumps(report, indent=2)
        if args.output and args.format == "json":
            args.output.write_text(json_out)
        elif not args.output or args.format == "both":
            print(json_out)

    if args.format in ("summary", "both"):
        if args.output and args.format == "summary":
            args.output.write_text(report["summary"])
        elif not args.output or args.format == "both":
            print(report["summary"])

    if args.format == "discord":
        discord_summary = emit_discord_summary(
            report["findings"]["oversized_results"],
            report["findings"]["repeated_commands"],
            report["findings"]["unused_skills"],
            report["findings"]["domain_fit"],
            report["findings"]["lane_ideation"],
            report["findings"]["context_churn"],
        )
        if args.output:
            args.output.write_text(discord_summary)
        else:
            print(discord_summary)


if __name__ == "__main__":
    main()
