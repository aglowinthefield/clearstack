#!/usr/bin/env python3
"""Append ClearStack run records to a local JSONL log.

The log is private to this machine. Commits link back to a run through a
`Clear-Run: <id>` trailer, and clear-stats joins the two later.
"""

import argparse
import json
import os
import secrets
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def log_path():
    base = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state"
    return Path(base) / "clearstack" / "runs.jsonl"


def git(*args):
    try:
        out = subprocess.run(["git", *args], capture_output=True, text=True, check=True)
    except (OSError, subprocess.CalledProcessError):
        return None
    return out.stdout.strip() or None


def git_state():
    return {
        "cwd": os.getcwd(),
        "remote": git("remote", "get-url", "origin"),
        "branch": git("branch", "--show-current"),
        "head": git("rev-parse", "HEAD"),
    }


def _claude_code_telemetry(session_id):
    """Read token, cost, model, and tool-call totals from a Claude Code transcript."""
    base = Path.home() / ".claude" / "projects"
    matches = list(base.glob(f"*/{session_id}.jsonl")) if base.is_dir() else []
    if not matches:
        return None
    tokens = {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0}
    cost = None
    model = None
    tool_calls = 0
    tool_breakdown = {}
    try:
        with matches[0].open(encoding="utf-8") as f:
            for line in f:
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if event.get("type") == "cost-state":
                    cost = event.get("totalCostUSD")
                    tokens = {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0}
                    model_usage = event.get("modelUsage") or {}
                    if model_usage:
                        model = max(model_usage.items(),
                                    key=lambda kv: kv[1].get("inputTokens", 0) + kv[1].get("outputTokens", 0))[0]
                    for usage in model_usage.values():
                        tokens["input"] += usage.get("inputTokens", 0)
                        tokens["output"] += usage.get("outputTokens", 0)
                        tokens["cache_read"] += usage.get("cacheReadInputTokens", 0)
                        tokens["cache_write"] += usage.get("cacheCreationInputTokens", 0)
                elif event.get("type") == "assistant":
                    content = (event.get("message") or {}).get("content")
                    if isinstance(content, list):
                        for c in content:
                            if isinstance(c, dict) and c.get("type") == "tool_use":
                                tool_calls += 1
                                name = c.get("name") or "unknown"
                                tool_breakdown[name] = tool_breakdown.get(name, 0) + 1
    except OSError:
        return None
    if cost is None:
        return None
    return {"source": "claude-code", "model": model, "tokens": tokens, "cost_usd": round(cost, 4),
            "tool_calls": tool_calls, "tool_breakdown": tool_breakdown}


def _codex_telemetry(thread_id):
    """Read token totals and tool-call counts from a Codex session rollout."""
    base = Path.home() / ".codex" / "sessions"
    matches = list(base.glob(f"**/*{thread_id}*.jsonl")) if base.is_dir() else []
    if not matches:
        return None
    usage = None
    model = None
    tool_calls = 0
    tool_breakdown = {}
    try:
        with matches[0].open(encoding="utf-8") as f:
            for line in f:
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if event.get("type") == "session_meta" and model is None:
                    base_instructions = (event.get("payload") or {}).get("base_instructions")
                    if isinstance(base_instructions, dict):
                        model = (base_instructions.get("provenance") or {}).get("model")
                elif event.get("type") == "event_msg":
                    payload = event.get("payload") or {}
                    if payload.get("type") == "token_count":
                        info = (payload.get("info") or {}).get("total_token_usage")
                        if info:
                            usage = info
                elif event.get("type") == "response_item":
                    payload = event.get("payload") or {}
                    if payload.get("type") == "function_call":
                        tool_calls += 1
                        name = payload.get("name") or "unknown"
                        tool_breakdown[name] = tool_breakdown.get(name, 0) + 1
    except OSError:
        return None
    if usage is None:
        return None
    return {
        "source": "codex",
        "model": model,
        "tokens": {
            "input": usage.get("input_tokens", 0),
            "output": usage.get("output_tokens", 0),
            "cache_read": usage.get("cached_input_tokens", 0),
            "cache_write": usage.get("cache_write_input_tokens", 0),
        },
        "cost_usd": None,
        "tool_calls": tool_calls,
        "tool_breakdown": tool_breakdown,
    }


def _hermes_home():
    return Path(os.environ.get("HERMES_HOME") or (Path.home() / ".hermes"))


def _hermes_session_path(session_id):
    direct = Path.home() / ".hermes" / "webui" / "sessions" / f"{session_id}.json"
    if direct.is_file():
        return direct
    profiles_root = Path.home() / ".hermes" / "profiles"
    if profiles_root.is_dir():
        matches = list(profiles_root.glob(f"*/sessions/{session_id}.json"))
        if matches:
            return matches[0]
    return None


def _hermes_telemetry_from_state_db(session_id):
    """Read token, cost, model, and tool-call breakdown from Hermes's state.db.

    This is where the desktop app and CLI actually persist sessions (a
    ``sessions`` row plus per-tool-call ``messages`` rows), as opposed to the
    legacy flat session JSON files under webui/profiles, which not every
    session type writes.
    """
    db_path = _hermes_home() / "state.db"
    if not db_path.is_file():
        return None
    import sqlite3
    try:
        uri = f"file:{db_path}?mode=ro"
        conn = sqlite3.connect(uri, uri=True, timeout=5.0)
        try:
            conn.execute("PRAGMA busy_timeout = 5000")
            row = conn.execute(
                "SELECT model, tool_call_count, input_tokens, output_tokens, "
                "cache_read_tokens, cache_write_tokens, estimated_cost_usd, actual_cost_usd "
                "FROM sessions WHERE id = ?",
                (session_id,),
            ).fetchone()
            if row is None:
                return None
            model, tool_call_count, input_tokens, output_tokens, cache_read, cache_write, est_cost, act_cost = row
            tool_breakdown = {}
            for name, count in conn.execute(
                "SELECT tool_name, COUNT(*) FROM messages "
                "WHERE session_id = ? AND tool_name IS NOT NULL GROUP BY tool_name",
                (session_id,),
            ):
                tool_breakdown[name or "unknown"] = count
        finally:
            conn.close()
    except sqlite3.Error:
        return None
    cost = act_cost if isinstance(act_cost, (int, float)) and act_cost else est_cost
    return {
        "source": "hermes",
        "model": model,
        "tokens": {
            "input": input_tokens or 0,
            "output": output_tokens or 0,
            "cache_read": cache_read or 0,
            "cache_write": cache_write or 0,
        },
        "cost_usd": round(cost, 4) if isinstance(cost, (int, float)) else None,
        "tool_calls": tool_call_count or sum(tool_breakdown.values()),
        "tool_breakdown": tool_breakdown,
    }


def _hermes_telemetry(session_id):
    """Read token, cost, model, and tool-call totals for a Hermes session.

    Tries the state.db first (current storage for desktop/CLI sessions), then
    falls back to the legacy flat session JSON file some older session types
    still use.
    """
    result = _hermes_telemetry_from_state_db(session_id)
    if result:
        return result
    path = _hermes_session_path(session_id)
    if path is None:
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if "input_tokens" not in data:
        return None
    tool_breakdown = {}
    for call in data.get("tool_calls") or []:
        name = (call.get("name") if isinstance(call, dict) else None) or "unknown"
        tool_breakdown[name] = tool_breakdown.get(name, 0) + 1
    return {
        "source": "hermes",
        "model": data.get("model"),
        "tokens": {
            "input": data.get("input_tokens", 0),
            "output": data.get("output_tokens", 0),
            "cache_read": data.get("cache_read_tokens", 0),
            "cache_write": data.get("cache_write_tokens", 0),
        },
        "cost_usd": data.get("estimated_cost"),
        "tool_calls": len(data.get("tool_calls") or []),
        "tool_breakdown": tool_breakdown,
    }


def telemetry():
    """Best-effort token/cost/tool-call totals from the harness's own local log.

    Returns None when no harness session id is set or its log is unreadable,
    never a dict of zeros, so the dashboard can tell "no data" from "zero".
    """
    claude_session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if claude_session:
        result = _claude_code_telemetry(claude_session)
        if result:
            return result
    codex_thread = os.environ.get("CODEX_THREAD_ID")
    if codex_thread:
        result = _codex_telemetry(codex_thread)
        if result:
            return result
    hermes_session = os.environ.get("HERMES_SESSION_ID")
    if hermes_session:
        result = _hermes_telemetry(hermes_session)
        if result:
            return result
    return None


def append(record):
    path = log_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    stamped = {"ts": datetime.now(timezone.utc).isoformat(timespec="seconds"), **record}
    with path.open("a") as f:
        f.write(json.dumps(stamped) + "\n")


def require_run(run_id):
    path = log_path()
    if path.exists():
        with path.open() as f:
            for line in f:
                entry = json.loads(line)
                if entry["event"] == "start" and entry["run"] == run_id:
                    return
    sys.exit(f"record: no run {run_id!r} in {path}")


def start(args):
    run_id = f"cr-{datetime.now(timezone.utc):%Y%m%d}-{secrets.token_hex(3)}"
    parent_run = args.parent_run or os.environ.get("CLEARSTACK_PARENT_RUN")
    append({
        "event": "start",
        "run": run_id,
        "task": args.task,
        "playbook": args.playbook,
        "agent": os.environ.get("AI_AGENT") or ("codex" if os.environ.get("CODEX_THREAD_ID") else None),
        "session": (
            os.environ.get("CLAUDE_CODE_SESSION_ID")
            or os.environ.get("CODEX_THREAD_ID")
            or os.environ.get("HERMES_SESSION_ID")
        ),
        "parent_run_id": parent_run,
        "spawned_by": args.spawned_by if parent_run else None,
        **git_state(),
    })
    print(run_id)


def note(args):
    require_run(args.run)
    append({"event": "note", "run": args.run, "text": args.text})


def end(args):
    require_run(args.run)
    if args.status == "parked" and not args.needs:
        sys.exit("record: a parked run names the decision it needs (--needs)")
    append({
        "event": "end",
        "run": args.run,
        "status": args.status,
        "verified": args.verified,
        "unverified": args.unverified,
        "needs": args.needs,
        "pr": args.pr,
        "telemetry": telemetry(),
        **git_state(),
    })


def main():
    parser = argparse.ArgumentParser(prog="record", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(required=True)

    p = sub.add_parser("start", help="open a run and print its id")
    p.add_argument("--task", required=True, help="the task in one line")
    p.add_argument("--playbook", default="none")
    p.add_argument("--parent-run", help="the run id that spawned this one, when this is a subagent")
    p.add_argument("--spawned-by", default="subagent",
                    help="how this run was spawned (e.g. delegate_task, subagent). Only recorded with --parent-run.")
    p.set_defaults(func=start)

    p = sub.add_parser("note", help="add a decision to the run's trail")
    p.add_argument("run")
    p.add_argument("text", help="decision, alternatives considered, and why")
    p.set_defaults(func=note)

    p = sub.add_parser("end", help="close a run with its claims")
    p.add_argument("run")
    p.add_argument("--status", required=True, choices=["done", "parked", "abandoned"])
    p.add_argument("--verified", action="append", default=[], metavar="CLAIM: EVIDENCE")
    p.add_argument("--unverified", action="append", default=[], metavar="CLAIM")
    p.add_argument("--needs", help="the one decision a parked run needs")
    p.add_argument("--pr", help="PR URL or number")
    p.set_defaults(func=end)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
