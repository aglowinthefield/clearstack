#!/usr/bin/env python3
"""Export every mem0 platform memory for one user as JSONL on stdout.

Reads MEM0_API_KEY from the environment, or from --env-file (KEY=value lines).
The user id comes from --user-id or MEM0_USER_ID.
"""

import argparse
import json
import os
import sys
import urllib.request
from pathlib import Path

API = "https://api.mem0.ai/v1/memories/"


def env_value(name, env_file):
    if os.environ.get(name):
        return os.environ[name]
    if env_file and Path(env_file).expanduser().exists():
        for line in Path(env_file).expanduser().read_text().splitlines():
            if line.startswith(f"{name}="):
                return line.split("=", 1)[1].strip().strip("'\"")
    return ""


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--user-id", default=os.environ.get("MEM0_USER_ID", ""))
    parser.add_argument("--env-file")
    args = parser.parse_args()
    key = env_value("MEM0_API_KEY", args.env_file)
    user = args.user_id or env_value("MEM0_USER_ID", args.env_file)
    if not key or not user:
        print("export-mem0: MEM0_API_KEY and a user id are required", file=sys.stderr)
        return 2
    page = 1
    while True:
        url = f"{API}?user_id={user}&page={page}&page_size=100"
        req = urllib.request.Request(url, headers={"Authorization": f"Token {key}"})
        data = json.loads(urllib.request.urlopen(req, timeout=60).read())
        for rec in data.get("results", []):
            print(json.dumps({k: rec.get(k) for k in ("id", "memory", "created_at", "updated_at")}))
        if not data.get("next"):
            return 0
        page += 1


if __name__ == "__main__":
    sys.exit(main())
